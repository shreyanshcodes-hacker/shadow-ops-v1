# ==============================================================================
# SHADOWOPS — VERCEL FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Configure these variables in the Vercel Project Settings > Environment Variables.
# Only variables prefixed with NEXT_PUBLIC_ are accessible in the browser bundle.
# NEVER place backend secrets (database passwords, private keys, service keys) here.

# ------------------------------------------------------------------------------
# 1. ShadowOps Backend API Endpoint
# ------------------------------------------------------------------------------
# URL pointing to your deployed FastAPI backend service.
# Example: https://api.shadowops.io/api/v1 or https://backend-production-xxxx.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. Firebase Client Authentication (Web SDK)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBEZHLrLGRMxkFL48yD7LOWxUaCg4dyRcY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shadow-ops-6957d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shadow-ops-6957d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shadow-ops-6957d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=96713617472
NEXT_PUBLIC_FIREBASE_APP_ID=1:96713617472:web:9d4db960807aa3e3cbafa5
