# ==============================================================================
# SHADOWOPS — STAGE 4 ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure real credentials.
# NEVER commit the active .env or .env.local to version control.

# ==============================================================================
# FRONTEND VARIABLES (Publicly exposed in client-side Next.js bundle)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shadow-ops-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shadow-ops-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shadow-ops-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==============================================================================
# BACKEND SENSITIVE VARIABLES (NEVER prefix with NEXT_PUBLIC_)
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
SECRET_KEY=generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL (Managed DB)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Firebase Authentication (Admin SDK)
FIREBASE_PROJECT_ID=shadow-ops-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@shadow-ops-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Stage 4: AI Security Manager Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-beta
AI_MAX_FINDINGS_PER_RUN=25
AI_MAX_INPUT_CHARS=12000
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3
AI_COST_CAP_PER_RUN_USD=2.0
AI_PROMPT_VERSION=v1.0
